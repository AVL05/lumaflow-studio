# Variables de docker compose. Copiar a `.env` en la raiz antes de `docker compose up`.
# No contiene secretos reales: son valores de desarrollo local.

APP_ENV=local
APP_DEBUG=false
APP_URL=http://localhost:8000
# Generar con: docker compose run --rm backend php artisan key:generate --show
APP_KEY=

DB_DATABASE=lumaflow_studio
DB_USERNAME=lumaflow
DB_PASSWORD=secret
DB_ROOT_PASSWORD=secret
DB_PORT=3306

FRONTEND_URLS=http://localhost:5173,http://localhost:8080
VITE_API_URL=http://localhost:8000/api

# Con el perfil `ollama` activo, usar http://ollama:11434
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1

# Sembrar datos de ejemplo en el primer arranque
SEED_DATABASE=false
