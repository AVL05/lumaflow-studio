{
  "name": "lumaflow-studio",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@10.34.1",
  "description": "Plataforma full-stack de gestion del flujo de trabajo para fotografos.",
  "scripts": {
    "start": "node scripts/start-local.mjs",
    "start:backend": "cd backend && php artisan serve --host=127.0.0.1 --port=8000",
    "start:frontend": "pnpm --dir frontend run dev --host localhost --port 5173",
    "dev": "pnpm run start",
    "build": "pnpm --dir frontend run build",
    "lint": "pnpm run lint:frontend && pnpm run lint:backend",
    "lint:frontend": "pnpm --dir frontend run lint",
    "lint:backend": "cd backend && php vendor/bin/pint --test",
    "format": "pnpm run format:frontend && pnpm run format:backend",
    "format:frontend": "pnpm --dir frontend run format",
    "format:backend": "cd backend && php vendor/bin/pint",
    "test": "pnpm run test:audit && pnpm run test:backend && pnpm run test:frontend",
    "test:audit": "node --test scripts/check-security-audit.test.mjs scripts/build-dependencies.test.mjs",
    "test:pwa": "pnpm --dir e2e exec playwright test --config=playwright.pwa.config.js",
    "test:support": "pnpm --dir e2e exec playwright test --config=playwright.support.config.js",
    "test:backend": "cd backend && php artisan test",
    "test:frontend": "pnpm --dir frontend run test",
    "test:e2e": "pnpm --dir e2e run test",
    "test:e2e:ui": "pnpm --dir e2e run test:ui",
    "test:e2e:report": "pnpm --dir e2e run report",
    "test:e2e:install": "pnpm --dir e2e run install:browsers",
    "setup": "pnpm run setup:backend && pnpm run setup:frontend",
    "setup:backend": "cd backend && composer setup",
    "setup:frontend": "pnpm install",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "docker:reset": "docker compose down -v"
  },
  "devDependencies": {},
  "pnpm": {
    "overrides": {
      "follow-redirects": "1.16.2",
      "workbox-build@7.4.1>glob": "14.0.3",
      "filelist@1.0.6>minimatch": "11.0.4",
      "brace-expansion@5": "5.0.12",
      "fast-uri": "3.1.9",
      "serialize-javascript": "7.1.3",
      "source-map-js": "1.2.2",
      "undici@7": "7.30.1"
    },
    "patchedDependencies": {
      "deepmerge@4.3.1": "patches/deepmerge@4.3.1.patch"
    }
  }
}
