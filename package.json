{
  "name": "lumaflow-studio",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@10.34.1",
  "description": "Plataforma full-stack de gestion del flujo de trabajo para fotografos.",
  "scripts": {
    "start": "node scripts/start-local.mjs",
    "start:backend": "cd backend && php artisan serve --host=127.0.0.1 --port=8000",
    "start:frontend": "pnpm --dir frontend run dev --host localhost --port 5173",
    "dev": "pnpm run start",
    "build": "pnpm --dir frontend run build",
    "lint": "pnpm run lint:frontend && pnpm run lint:backend",
    "lint:frontend": "pnpm --dir frontend run lint",
    "lint:backend": "cd backend && php vendor/bin/pint --test",
    "format": "pnpm run format:frontend && pnpm run format:backend",
    "format:frontend": "pnpm --dir frontend run format",
    "format:backend": "cd backend && php vendor/bin/pint",
    "test": "pnpm run test:backend && pnpm run test:frontend",
    "test:backend": "cd backend && php artisan test",
    "test:frontend": "pnpm --dir frontend run test",
    "setup": "pnpm run setup:backend && pnpm run setup:frontend",
    "setup:backend": "cd backend && composer setup",
    "setup:frontend": "pnpm install",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "docker:reset": "docker compose down -v"
  },
  "devDependencies": {}
}
