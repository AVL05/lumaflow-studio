VITE_API_URL=http://localhost:8000/api
VITE_WEBGPU_AI_MODEL=Llama-3.2-1B-Instruct-q4f16_1-MLC

# Apoyo voluntario: dejar vacías hasta verificar perfiles y revisión previa de activación.
# Solo URLs públicas HTTPS de perfiles Ko-fi/GitHub Sponsors. Nunca claves ni SDK.
VITE_KOFI_URL=
VITE_GITHUB_SPONSORS_URL=

# Observabilidad opcional (Sentry). Sin DSN no se envia nada.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=
VITE_SENTRY_RELEASE=

# Proveedor de teselas del mapa (opcional; por defecto OpenStreetMap, sin clave).
# {key} en la URL se sustituye por VITE_MAP_TILE_KEY.
VITE_MAP_TILE_URL=
VITE_MAP_TILE_KEY=
VITE_MAP_TILE_ATTRIBUTION=
VITE_MAP_TILE_DARK_FILTER=true
VITE_MAP_TILE_MAX_ZOOM=19
VITE_MAP_TILE_SUBDOMAINS=abc
