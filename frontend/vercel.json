{
  "routes": [
    {
      "src": "^/index\\.html$",
      "status": 308,
      "headers": {
        "Location": "/"
      }
    },
    {
      "src": "^/security/?$",
      "status": 308,
      "headers": {
        "Location": "/privacy"
      }
    },
    {
      "src": "^/(features|pricing|privacy|about-project|support)(?:/|\\.html)$",
      "status": 308,
      "headers": {
        "Location": "/$1"
      }
    },
    {
      "src": "^/(?:|features|pricing|privacy|about-project|support)$",
      "has": [
        {
          "type": "query",
          "key": "token"
        }
      ],
      "headers": {
        "X-Robots-Tag": "noindex, nofollow, nosnippet",
        "Referrer-Policy": "no-referrer"
      },
      "dest": "/app-shell.html"
    },
    {
      "src": "^/(?:|features|pricing|privacy|about-project|support)$",
      "has": [
        {
          "type": "query",
          "key": "signature"
        }
      ],
      "headers": {
        "X-Robots-Tag": "noindex, nofollow, nosnippet",
        "Referrer-Policy": "no-referrer"
      },
      "dest": "/app-shell.html"
    },
    {
      "src": "^/(?:|features|pricing|privacy|about-project|support)$",
      "has": [
        {
          "type": "query",
          "key": "email"
        }
      ],
      "headers": {
        "X-Robots-Tag": "noindex, nofollow, nosnippet",
        "Referrer-Policy": "no-referrer"
      },
      "dest": "/app-shell.html"
    },
    {
      "src": "^/(?:app(?:/.*)?|login|register|forgot-password|reset-password|verify-email|onboarding|getting-started|demo|deliver/[^/]+|contract/[^/]+|book/[^/]+|app-shell\\.html|404\\.html)/?$",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow, nosnippet",
        "Referrer-Policy": "no-referrer"
      },
      "continue": true
    },
    {
      "src": "^/(features|pricing|privacy|about-project|support)$",
      "dest": "/$1.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/(?:app(?:/.*)?|login|register|forgot-password|reset-password|verify-email|onboarding|getting-started|demo|deliver/[^/]+|contract/[^/]+|book/[^/]+|app-shell\\.html|404\\.html)/?$",
      "dest": "/app-shell.html"
    },
    {
      "src": "^/.*$",
      "dest": "/404.html",
      "status": 404,
      "headers": {
        "X-Robots-Tag": "noindex, nofollow, nosnippet",
        "Referrer-Policy": "no-referrer"
      }
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.basemaps.cartocdn.com; font-src 'self' data:; connect-src 'self' https://lumaflow-api.aleviclop.dev https://huggingface.co https://*.huggingface.co https://*.hf.co https://raw.githubusercontent.com https://*.ingest.sentry.io https://*.ingest.de.sentry.io; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()" }
      ]
    }
  ]
}
